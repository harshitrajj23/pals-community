# ==============================================================================
# PALS Community Backend Environment Configuration
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# Admin Authentication
# Used to protect all /api/admin/* endpoints
ADMIN_API_KEY=pals_admin_secret_key_2026

# Database (Supabase)
# Find these in your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Instagram / Meta Graph API
# Real production credentials (leave MOCK_INSTAGRAM=true during local testing)
MOCK_INSTAGRAM=true
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_long_lived_instagram_graph_api_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_VERIFY_TOKEN=pals_webhook_verify_token_2026

# Mistral AI
# Used to classify post captions into categories (Hackathon, Event, Workshop, etc.)
MISTRAL_API_KEY=your_mistral_api_key_here

# Redis Cache (Optional - fallback to high-performance in-memory cache if omitted)
REDIS_URL=
